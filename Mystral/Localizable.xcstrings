  "sourceLanguage": "en",
  "strings": {
    "%@ reading %lld RPM while target is %lld%%.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ rileva %2$lld RPM mentre il target è %3$lld%%."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 当前读数为 %2$lld RPM，而目标设定为 %3$lld%%。"
          }
        }
      }
    },
    "(any match)": {
